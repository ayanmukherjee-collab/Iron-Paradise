{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vite/client"],
    "paths": {
      // Shared components still import these Next.js-era modules; the
      // static app supplies them (web/vite.config.mts aliases the same ids).
      "next/link": ["./web/src/shims/next-link.tsx"],
      "next/navigation": ["./web/src/shims/next-navigation.ts"],
      "@/attendance/actions": ["./web/src/actions/attendance.ts"],
      "@/auth/sign-in-actions": ["./web/src/actions/sign-in.ts"],
      "@/auth/team-actions": ["./web/src/actions/team.ts"],
      "@/bulletin/actions": ["./web/src/actions/bulletin.ts"],
      "@/bulletin/use-bulletin": ["./web/src/shims/use-bulletin.ts"],
      "@/bulletin/use-crowd": ["./web/src/shims/use-crowd.ts"],
      "@/members/actions": ["./web/src/actions/members.ts"],
      "@/members/claim-actions": ["./web/src/actions/claim.ts"],
      "@/notifications/actions": ["./web/src/actions/notifications.ts"],
      "@/payments/actions": ["./web/src/actions/payments.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "web/src", "web/*.mts", "supabase/functions-src", "*.mts"],
  "exclude": ["node_modules", "web/dist", ".claude"]
}
