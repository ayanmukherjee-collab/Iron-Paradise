{
  "name": "iron-paradise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-sw.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art": "node scripts/process-art.mjs",
    "map": "node scripts/make-map.mjs",
    "icons": "node scripts/make-icons.mjs",
    "vapid": "node scripts/make-vapid-keys.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:size": "node scripts/check-bundle-size.mjs",
    "db:push": "supabase db push",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-table": "9.3.1",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "server-only": "0.0.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@electric-sql/pglite": "0.5.16",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serwist": "9.5.13",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22"
  }
}
