# Copy to .env.local for local development. Never commit real values.
# In production these are set as Cloudflare Worker variables and secrets
# (see README "Deploying").

# --- Site -------------------------------------------------------------------
# Public origin of the app, no trailing slash. Used for the Google sign-in
# return URL, so it must also be listed under Supabase → Authentication →
# URL Configuration → Redirect URLs (as <SITE_URL>/auth/callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys / Data API) ------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe in the browser; RLS
# protects the data. Do NOT put the secret/service_role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Postgres connection string. Use the "Transaction pooler" string
# (port 6543) from Connect → ORMs / Transaction pooler, with your DB password.
# The app switches to the signed-in user's role for every query, so RLS applies.
DATABASE_URL=

# --- Cloudflare Turnstile (bot check on sign-in) -----------------------------
# These defaults are Cloudflare's official test keys: the widget always passes.
# Replace with real keys from Cloudflare dashboard → Turnstile before going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Upstash Redis (rate limiting only) --------------------------------------
# REST URL and token from the Upstash console. Optional in development (rate
# limiting is skipped with a warning); the app refuses to run without them in
# production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
