# Copy to .env.local for local development. Never commit real values.
# The app is built into plain files, so every NEXT_PUBLIC_ value is baked in
# at build time and is public. In production they are set under the
# Cloudflare Worker's Build variables (see README "Deploying").

# --- Site -------------------------------------------------------------------
# Public origin of the app, no trailing slash. Used in claim and desk links.
# Supabase → Authentication → URL Configuration → Redirect URLs must list
# <origin>/auth/callback for every origin you sign in from.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# --- Supabase (Project Settings → API Keys / Data API) ------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe in the browser; RLS
# protects the data. Do NOT put the secret/service_role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string, only for applying migrations (npm run db:push).
# Use the "Session pooler" string (port 5432) from Connect.
DATABASE_URL=

# --- Fee reminders (optional) ------------------------------------------------
# Push notifications. Generate a pair once with `npm run vapid`. The public
# key is built into the app (browsers need it); the private key is a secret
# of the Supabase Edge Functions only (README "Reminders").
VAPID_PUBLIC_KEY=
# Set to "on" when the reminder job sends emails, so the Reminders page says so.
NEXT_PUBLIC_EMAIL_REMINDERS=
