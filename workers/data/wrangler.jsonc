// The public data Worker (see index.ts). Deployed on its own, separately
// from the main app: `npx wrangler deploy -c workers/data/wrangler.jsonc`.
// It changes rarely; the main app's Workers Builds does not deploy it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iron-paradise-data",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Workers Cache: Cloudflare answers from its cache, without running this
  // Worker, for as long as the response's Cache-Control allows (60 s).
  "cache": {
    "enabled": true,
  },
  // Same namespace as the main app's PUBLIC_DATA binding (../../wrangler.jsonc).
  // This Worker only reads it.
  "kv_namespaces": [
    {
      "binding": "PUBLIC_DATA",
      "id": "1c0f4eeea579466683c38ea8e9d691e2",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
