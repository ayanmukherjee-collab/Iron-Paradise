// Cloudflare Worker that serves the app (built by `npm run cf:build`).
// Secrets are not kept here. Set them once with `npx wrangler secret put NAME`
// (see README "Deploying"). NEXT_PUBLIC_ values are baked in at build time.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iron-paradise",
  // worker.mjs wraps OpenNext's .open-next/worker.js to add the Cron Trigger.
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // OpenNext calls back into its own Worker; the name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "iron-paradise",
    },
  ],
  // Run the Worker next to the Supabase database (AWS Mumbai) instead of at
  // whichever edge the visitor reaches (often Singapore from India). Every
  // page makes several database round trips, and each one is ~80 ms across
  // that gap but only a few ms inside the same region.
  "placement": {
    "region": "aws:ap-south-1",
  },
  // Due reminders (brief §4.6): every 15 minutes from 08:30 to 11:15 in
  // India (03:00–05:45 UTC). Each run sends what fits in Cloudflare's
  // free-plan request limit and later runs carry on; nothing is sent twice.
  "triggers": {
    "crons": ["*/15 3-5 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
