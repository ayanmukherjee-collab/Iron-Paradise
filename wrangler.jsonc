// Cloudflare serves the app as plain files (built by `npm run cf:build`
// into web/dist). There is no Worker script: every request is a static
// asset, which Cloudflare serves for free, without limit and without
// running any code, so the free plan's 10 ms CPU limit no longer applies.
// Data and saves go from the phone straight to Supabase (docs/static-rebuild.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iron-paradise",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "web/dist",
    // Any address that isn't a file (/app/members/…, /claim/…) gets
    // index.html, and the app's router takes it from there.
    "not_found_handling": "single-page-application",
    // /privacy serves privacy.html (written at build time).
    "html_handling": "auto-trailing-slash",
  },
  // The old Worker ran the reminder job on a Cron Trigger. Reminders now run
  // in a Supabase Edge Function on pg_cron; an empty list clears the old
  // schedule on the next deploy.
  "triggers": {
    "crons": [],
  },
  "observability": {
    "enabled": true,
  },
}
